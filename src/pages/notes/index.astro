---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Notes" description="Mathematical notes and occasional writing by John Rick Manzanares.">
  <header class="page-hero shell">
    <p class="kicker">Notes</p>
    <h1>Working notes, explanations, and reflections.</h1>
    <p class="page-intro">
      This is the less formal side of the site: mathematical explanations I want to make self-contained,
      teaching notes in progress, and occasional writing about research and academic life.
    </p>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Academic life</p>
          <h2>Personal writing</h2>
        </div>
        <p>The long-form journal that previously lived on the home page now has its own reading space.</p>
      </div>
      <div class="timeline">
        <article class="timeline-card">
          <time>Updated 16 May 2025</time>
          <h3>Strangers and Struggles in a New World</h3>
          <p>
            Notes written during the first year of moving abroad for doctoral research, spanning
            November 2024 to May 2025.
          </p>
          <div class="inline-links">
            <a href="/notes/strangers-and-struggles-in-a-new-world/">Read article →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="kicker">Mathematics</p>
          <h2>A growing notebook</h2>
        </div>
        <p>
          Future entries will collect self-contained explanations in topology, analysis, TDA,
          scientific computing, and related topics rather than burying them in one long page.
        </p>
      </div>
    </div>
  </section>
</Layout>
