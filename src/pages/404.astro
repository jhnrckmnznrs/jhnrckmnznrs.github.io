---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="page-hero shell">
    <p class="kicker">404</p>
    <h1>This component disappeared.</h1>
    <p class="page-intro">
      The page may have moved during a transformation of the site.
    </p>
    <div class="actions">
      <a class="button" href="/">Return home</a>
      <a class="button secondary" href="/research/">Browse research</a>
    </div>
  </section>
</Layout>
