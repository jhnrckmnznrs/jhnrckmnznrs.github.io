---
const year = new Date().getFullYear();

const primaryLinks = [
  ['/research/', 'Research'],
  ['/publications/', 'Publications'],
  ['/software/', 'Software'],
  ['/teaching/', 'Teaching'],
  ['/notes/', 'Notes']
];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="kicker">Banyuhay</p>
      <p class="footer-line">
        Mathematics, research, teaching, software, and the questions that connect them.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      {primaryLinks.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="footer-links" aria-label="External links">
      <a href="https://github.com/jhnrckmnznrs" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:jdolormanzanares@impan.pl">Email</a>
      <a href="https://dioscuri-tda.org/" target="_blank" rel="noopener noreferrer">Dioscuri TDA</a>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {year} John Rick Manzanares.</span>
    <span>Becoming, always.</span>
  </div>
</footer>
