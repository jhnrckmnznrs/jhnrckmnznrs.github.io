---
const pathname = Astro.url.pathname;
const links = [
  ['/research/', 'Research'],
  ['/publications/', 'Publications'],
  ['/software/', 'Software'],
  ['/teaching/', 'Teaching'],
  ['/notes/', 'Notes'],
  ['/about/', 'About']
];

const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href="/" aria-label="John Rick Manzanares home">
      <svg class="brand-mark" viewBox="0 0 42 42" aria-hidden="true">
        <circle cx="12" cy="14" r="4"></circle>
        <circle cx="29" cy="11" r="3"></circle>
        <circle cx="31" cy="29" r="5"></circle>
        <circle cx="13" cy="30" r="3"></circle>
        <path d="M15 15.5 26 12M14 17l14 10M16 30h10M14 27l13-13"></path>
      </svg>
      <span>
        <strong>John Rick Manzanares</strong>
        <small>Banyuhay</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(([href, label]) => (
        <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {links.map(([href, label]) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
