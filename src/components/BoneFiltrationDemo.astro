---
const size = 11;
const cells = [];

const inRing = (x, y) =>
  x >= 4 && x <= 8 && y >= 2 && y <= 6 &&
  (x === 4 || x === 8 || y === 2 || y === 6);

const inRingInterior = (x, y) =>
  x >= 5 && x <= 7 && y >= 3 && y <= 5;

const lowerComponent = new Set(['1,8', '2,8', '2,9', '3,9', '1,9']);
const bridge = new Set(['3,8', '4,8', '4,7']);

for (let y = 0; y < size; y += 1) {
  for (let x = 0; x < size; x += 1) {
    const k = `${x},${y}`;
    let value = 90;
    let role = 'background';

    if (lowerComponent.has(k)) {
      value = 18;
      role = 'early-component';
    } else if (inRing(x, y)) {
      value = 28;
      role = 'ring';
    } else if (bridge.has(k)) {
      value = 45;
      role = 'bridge';
    } else if (inRingInterior(x, y)) {
      value = 68;
      role = 'interior';
    }

    cells.push({ x, y, value, role });
  }
}

const persistencePoints = [
  {
    id: 'h0-ring',
    dimension: 0,
    birth: 28,
    death: 45,
    label: 'Ring component',
    explanation:
      'At threshold 28, the ring enters as a component separate from the earlier component. At threshold 45, the bridge connects them. Under the elder rule, the younger component dies at this merge.'
  },
  {
    id: 'h1-void',
    dimension: 1,
    birth: 28,
    death: 68,
    label: 'Enclosed void',
    explanation:
      'When the ring closes at threshold 28, it encloses a background region. The void persists until threshold 68, when the interior cells enter and fill it.'
  }
];

const milestones = [
  { value: 18, label: 'first component' },
  { value: 28, label: 'ring and void' },
  { value: 45, label: 'components merge' },
  { value: 68, label: 'void fills' },
  { value: 90, label: 'grid fills' }
];

const plot = {
  left: 46,
  right: 310,
  top: 22,
  bottom: 286,
  min: 10,
  max: 80
};

const sx = (value) =>
  plot.left + ((value - plot.min) / (plot.max - plot.min)) * (plot.right - plot.left);

const sy = (value) =>
  plot.bottom - ((value - plot.min) / (plot.max - plot.min)) * (plot.bottom - plot.top);
---

<section class="filtration-demo" id="filtration-demo" aria-labelledby="filtration-title">
  <div class="demo-heading">
    <div>
      <p class="eyebrow">Interactive concept</p>
      <h2 id="filtration-title">Connect a filtration to persistence</h2>
    </div>
    <p>
      The example is deliberately small. Its purpose is to make birth, death, merging, and persistence
      visible before the same ideas are applied to images in three dimensions.
    </p>
  </div>

  <ol class="demo-guide" aria-label="How to use the demonstration">
    <li><span>1</span>Move the threshold and watch cells enter the filtration.</li>
    <li><span>2</span>Compare the Betti numbers with the persistence diagram.</li>
    <li><span>3</span>Select a persistence point to inspect its interval and an explanatory witness.</li>
  </ol>

  <div class="linked-demo">
    <div class="grid-panel">
      <h3>Filtration</h3>
      <svg
        class="cubical-grid"
        viewBox="0 0 330 330"
        role="img"
        aria-labelledby="grid-title grid-desc"
        data-grid
      >
        <title id="grid-title">Synthetic cubical filtration in two dimensions</title>
        <desc id="grid-desc">
          A teaching grid containing an early component, a ring, a later bridge, and an interior that
          eventually fills the ring. Cells enter as the threshold increases.
        </desc>

        {cells.map((cell) => (
          <rect
            x={cell.x * 30 + 1}
            y={cell.y * 30 + 1}
            width="28"
            height="28"
            rx="2"
            data-cell
            data-x={cell.x}
            data-y={cell.y}
            data-level={cell.value}
            data-role={cell.role}
          />
        ))}
      </svg>

      <div class="legend" aria-hidden="true">
        <span><i class="legend-cell inactive"></i> not entered</span>
        <span><i class="legend-cell active"></i> entered</span>
        <span><i class="legend-cell hole"></i> enclosed void</span>
        <span><i class="legend-cell witness"></i> selected witness</span>
      </div>
    </div>

    <div class="diagram-panel">
      <h3>Persistence diagram</h3>
      <svg
        class="persistence-diagram"
        viewBox="0 0 340 320"
        role="img"
        aria-labelledby="pd-title pd-desc"
      >
        <title id="pd-title">Persistence diagram for the finite classes in the teaching filtration</title>
        <desc id="pd-desc">
          The diagram contains a dimension 0 point born at 28 and dying at 45, and a dimension 1 point
          born at 28 and dying at 68. The earlier dimension 0 component is essential and is listed
          separately because its death time is infinite.
        </desc>

        <rect
          class="alive-region"
          x={plot.left}
          y={plot.top}
          width={sx(45) - plot.left}
          height={sy(45) - plot.top}
          data-alive-region
          aria-hidden="true"
        />

        <line class="axis" x1={plot.left} y1={plot.bottom} x2={plot.right} y2={plot.bottom} />
        <line class="axis" x1={plot.left} y1={plot.bottom} x2={plot.left} y2={plot.top} />
        <line
          class="diagonal"
          x1={sx(plot.min)}
          y1={sy(plot.min)}
          x2={sx(plot.max)}
          y2={sy(plot.max)}
        />

        {[20, 40, 60, 80].map((tick) => (
          <g class="tick" aria-hidden="true">
            <line x1={sx(tick)} y1={plot.bottom} x2={sx(tick)} y2={plot.bottom + 5} />
            <text x={sx(tick)} y={plot.bottom + 20} text-anchor="middle">{tick}</text>
            <line x1={plot.left - 5} y1={sy(tick)} x2={plot.left} y2={sy(tick)} />
            <text x={plot.left - 10} y={sy(tick) + 4} text-anchor="end">{tick}</text>
          </g>
        ))}

        <text class="axis-label" x={(plot.left + plot.right) / 2} y="316" text-anchor="middle">birth</text>
        <text
          class="axis-label"
          x="15"
          y={(plot.top + plot.bottom) / 2}
          text-anchor="middle"
          transform={`rotate(-90 15 ${(plot.top + plot.bottom) / 2})`}
        >
          death
        </text>

        <line
          class="threshold-guide"
          x1={sx(45)}
          y1={plot.top}
          x2={sx(45)}
          y2={plot.bottom}
          data-threshold-x
        />
        <line
          class="threshold-guide"
          x1={plot.left}
          y1={sy(45)}
          x2={plot.right}
          y2={sy(45)}
          data-threshold-y
        />

        {persistencePoints.map((point) => (
          <g
            class:list={['pd-point', `pd-h${point.dimension}`]}
            role="button"
            tabindex="0"
            aria-label={`${point.label}, dimension ${point.dimension}, birth ${point.birth}, death ${point.death}, persistence ${point.death - point.birth}`}
            data-persistence-point
            data-feature={point.id}
            data-dimension={point.dimension}
            data-birth={point.birth}
            data-death={point.death}
            data-label={point.label}
            data-explanation={point.explanation}
            transform={`translate(${sx(point.birth)} ${sy(point.death)})`}
          >
            <circle r="9" />
            <text x="13" y="-11">H{point.dimension}</text>
          </g>
        ))}
      </svg>

      <p class="diagram-help">
        The shaded region contains classes whose birth is at most the current threshold and whose death
        is greater than it. These are the finite classes that are alive at that threshold.
      </p>

      <div class="diagram-key">
        <span><i class="point-key h0"></i> H<sub>0</sub></span>
        <span><i class="point-key h1"></i> H<sub>1</sub></span>
        <span><i class="region-key"></i> alive at the current threshold</span>
      </div>

      <div class="feature-buttons" aria-label="Persistence features">
        {persistencePoints.map((point) => (
          <button
            type="button"
            data-feature-button
            data-feature={point.id}
          >
            <span>H<sub>{point.dimension}</sub></span>
            {point.label}
            <small>({point.birth}, {point.death})</small>
          </button>
        ))}
      </div>

      <div class="essential-class">
        <span>H<sub>0</sub></span>
        <div>
          <strong>Essential component</strong>
          <small>birth 18 · death ∞</small>
        </div>
      </div>
    </div>
  </div>

  <div class="controls-panel">
    <label for="filtration-threshold">
      Filtration threshold
      <output id="filtration-value" for="filtration-threshold">45</output>
    </label>

    <input
      id="filtration-threshold"
      type="range"
      min="10"
      max="90"
      value="45"
      step="1"
      data-threshold
    />

    <ol class="milestones" aria-label="Filtration milestones">
      {milestones.map((milestone) => (
        <li style={`left: ${((milestone.value - 10) / 80) * 100}%`}>
          <b>{milestone.value}</b>
          <span>{milestone.label}</span>
        </li>
      ))}
    </ol>

    <div class="betti-readout" aria-live="polite" aria-atomic="true">
      <div>
        <span class="symbol">β<sub>0</sub></span>
        <strong data-b0>0</strong>
        <small>components under edge adjacency</small>
      </div>
      <div>
        <span class="symbol">β<sub>1</sub></span>
        <strong data-b1>0</strong>
        <small>enclosed voids</small>
      </div>
    </div>

    <p class="demo-status" data-status>
      Adjust the threshold to see components appear, merge, and enclose a void.
    </p>
  </div>

  <div class="feature-inspector" data-feature-inspector aria-live="polite">
    <div>
      <p class="eyebrow">Selected persistence class</p>
      <h3 data-feature-title>Select a persistence point</h3>
    </div>

    <dl>
      <div><dt>Dimension</dt><dd data-feature-dimension>Not selected</dd></div>
      <div><dt>Birth</dt><dd data-feature-birth>Not selected</dd></div>
      <div><dt>Death</dt><dd data-feature-death>Not selected</dd></div>
      <div><dt>Persistence</dt><dd data-feature-persistence>Not selected</dd></div>
      <div><dt>At current threshold</dt><dd data-feature-state>Not selected</dd></div>
    </dl>

    <p data-feature-explanation>
      Choose either point in the diagram or one of the equivalent buttons below it.
    </p>

    <div class="feature-actions" hidden data-feature-actions>
      <button type="button" data-jump="birth">Jump to birth</button>
      <button type="button" data-jump="middle">View while alive</button>
      <button type="button" data-jump="death">Jump to death</button>
    </div>
  </div>

  <div class="concept-note">
    <strong>This is a teaching construction, not research specimen data.</strong>
    <p>
      The scalar values were chosen so that the finite classes are known and easy to inspect.
      The H<sub>0</sub> interval is [28, 45), the H<sub>1</sub> interval is [28, 68), and the first
      H<sub>0</sub> class is essential.
    </p>
    <p>
      When a persistence point is selected, highlighted cells provide one explanatory witness for this
      construction. In general, a persistence class does not come with a unique canonical geometric representative.
    </p>
  </div>
</section>

<script>
  const root = document.querySelector('#filtration-demo');

  if (root) {
    const slider = root.querySelector('[data-threshold]');
    const output = root.querySelector('#filtration-value');
    const cells = Array.from(root.querySelectorAll('[data-cell]'));
    const b0Node = root.querySelector('[data-b0]');
    const b1Node = root.querySelector('[data-b1]');
    const statusNode = root.querySelector('[data-status]');
    const pdPoints = Array.from(root.querySelectorAll('[data-persistence-point]'));
    const featureButtons = Array.from(root.querySelectorAll('[data-feature-button]'));
    const thresholdX = root.querySelector('[data-threshold-x]');
    const thresholdY = root.querySelector('[data-threshold-y]');
    const aliveRegion = root.querySelector('[data-alive-region]');
    const featureTitle = root.querySelector('[data-feature-title]');
    const featureDimension = root.querySelector('[data-feature-dimension]');
    const featureBirth = root.querySelector('[data-feature-birth]');
    const featureDeath = root.querySelector('[data-feature-death]');
    const featurePersistence = root.querySelector('[data-feature-persistence]');
    const featureState = root.querySelector('[data-feature-state]');
    const featureExplanation = root.querySelector('[data-feature-explanation]');
    const featureActions = root.querySelector('[data-feature-actions]');
    const jumpButtons = Array.from(root.querySelectorAll('[data-jump]'));
    const size = 11;
    let selectedFeature = null;

    const plot = {
      left: 46,
      right: 310,
      top: 22,
      bottom: 286,
      min: 10,
      max: 80
    };

    const sx = (value) =>
      plot.left + ((value - plot.min) / (plot.max - plot.min)) * (plot.right - plot.left);

    const sy = (value) =>
      plot.bottom - ((value - plot.min) / (plot.max - plot.min)) * (plot.bottom - plot.top);

    const key = (x, y) => `${x},${y}`;

    const neighbours = (x, y) => [
      [x - 1, y],
      [x + 1, y],
      [x, y - 1],
      [x, y + 1]
    ].filter(([nx, ny]) => nx >= 0 && nx < size && ny >= 0 && ny < size);

    const countComponents = (active) => {
      const seen = new Set();
      let count = 0;

      active.forEach((_, k) => {
        if (seen.has(k)) return;
        count += 1;
        const queue = [k];
        seen.add(k);

        while (queue.length) {
          const current = queue.shift();
          const [x, y] = current.split(',').map(Number);

          neighbours(x, y).forEach(([nx, ny]) => {
            const next = key(nx, ny);
            if (active.has(next) && !seen.has(next)) {
              seen.add(next);
              queue.push(next);
            }
          });
        }
      });

      return count;
    };

    const findHoles = (active) => {
      const seen = new Set();
      const holeCells = new Set();
      let holes = 0;

      for (let y = 0; y < size; y += 1) {
        for (let x = 0; x < size; x += 1) {
          const start = key(x, y);
          if (active.has(start) || seen.has(start)) continue;

          const queue = [start];
          const component = [];
          let touchesBoundary = false;
          seen.add(start);

          while (queue.length) {
            const current = queue.shift();
            const [cx, cy] = current.split(',').map(Number);
            component.push(current);

            if (cx === 0 || cy === 0 || cx === size - 1 || cy === size - 1) {
              touchesBoundary = true;
            }

            neighbours(cx, cy).forEach(([nx, ny]) => {
              const next = key(nx, ny);
              if (!active.has(next) && !seen.has(next)) {
                seen.add(next);
                queue.push(next);
              }
            });
          }

          if (!touchesBoundary) {
            holes += 1;
            component.forEach((cell) => holeCells.add(cell));
          }
        }
      }

      return { holes, holeCells };
    };

    const featureData = (node) => ({
      id: node.dataset.feature,
      dimension: Number(node.dataset.dimension),
      birth: Number(node.dataset.birth),
      death: Number(node.dataset.death),
      label: node.dataset.label,
      explanation: node.dataset.explanation
    });

    const stateAt = (feature, threshold) => {
      if (threshold < feature.birth) return 'not yet born';
      if (threshold >= feature.death) return 'already died';
      return 'alive';
    };

    const updateInspectorState = () => {
      if (!selectedFeature) return;
      featureState.textContent = stateAt(selectedFeature, Number(slider.value));
    };

    const updateWitness = () => {
      cells.forEach((cell) => cell.classList.remove('is-witness'));
      if (!selectedFeature) return;

      if (selectedFeature.id === 'h0-ring') {
        cells
          .filter((cell) => cell.dataset.role === 'ring')
          .forEach((cell) => cell.classList.add('is-witness'));
      }

      if (selectedFeature.id === 'h1-void') {
        cells
          .filter((cell) => cell.dataset.role === 'ring' || cell.dataset.role === 'interior')
          .forEach((cell) => cell.classList.add('is-witness'));
      }
    };

    const selectFeature = (featureId) => {
      const source = pdPoints.find((point) => point.dataset.feature === featureId);
      if (!source) return;

      selectedFeature = featureData(source);

      pdPoints.forEach((point) => {
        const selected = point.dataset.feature === featureId;
        point.classList.toggle('is-selected', selected);
        point.setAttribute('aria-pressed', String(selected));
      });

      featureButtons.forEach((button) => {
        const selected = button.dataset.feature === featureId;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-pressed', String(selected));
      });

      featureTitle.textContent = selectedFeature.label;
      featureDimension.textContent = `H${selectedFeature.dimension}`;
      featureBirth.textContent = String(selectedFeature.birth);
      featureDeath.textContent = String(selectedFeature.death);
      featurePersistence.textContent = String(selectedFeature.death - selectedFeature.birth);
      featureExplanation.textContent = selectedFeature.explanation;
      featureActions.hidden = false;

      updateInspectorState();
      updateWitness();
    };

    const updateThresholdGeometry = (threshold) => {
      const clamped = Math.max(plot.min, Math.min(plot.max, threshold));
      const x = sx(clamped);
      const y = sy(clamped);

      thresholdX.setAttribute('x1', String(x));
      thresholdX.setAttribute('x2', String(x));
      thresholdY.setAttribute('y1', String(y));
      thresholdY.setAttribute('y2', String(y));

      aliveRegion.setAttribute('width', String(Math.max(0, x - plot.left)));
      aliveRegion.setAttribute('height', String(Math.max(0, y - plot.top)));
    };

    const render = () => {
      const threshold = Number(slider.value);
      const active = new Map();

      cells.forEach((cell) => {
        const x = Number(cell.dataset.x);
        const y = Number(cell.dataset.y);
        const level = Number(cell.dataset.level);
        const isActive = level <= threshold;

        cell.classList.toggle('is-active', isActive);
        cell.classList.remove('is-hole');

        if (isActive) active.set(key(x, y), true);
      });

      const components = countComponents(active);
      const { holes, holeCells } = findHoles(active);

      cells.forEach((cell) => {
        const cellKey = key(Number(cell.dataset.x), Number(cell.dataset.y));
        if (!active.has(cellKey) && holeCells.has(cellKey)) {
          cell.classList.add('is-hole');
        }
      });

      output.value = threshold;
      output.textContent = String(threshold);
      b0Node.textContent = String(components);
      b1Node.textContent = String(holes);
      updateThresholdGeometry(threshold);

      pdPoints.forEach((point) => {
        const feature = featureData(point);
        point.dataset.state = stateAt(feature, threshold);
      });

      let message = 'At this threshold, no teaching feature has entered the filtration.';

      if (threshold >= 18 && threshold < 28) {
        message = 'The first component has appeared. It becomes the essential H₀ class in this example.';
      } else if (threshold >= 28 && threshold < 45) {
        message = 'The ring has appeared as a second component and also encloses a void. Here β₀ = 2 and β₁ = 1.';
      } else if (threshold >= 45 && threshold < 68) {
        message = 'The bridge has merged the two components. The finite H₀ class has died, while the H₁ void remains alive.';
      } else if (threshold >= 68 && threshold < 90) {
        message = 'The interior has entered and filled the void. Both finite classes shown in the diagram have died.';
      } else if (threshold >= 90) {
        message = 'All cells have entered. The grid is filled and only the essential connected component remains.';
      }

      statusNode.textContent = message;
      updateInspectorState();
      updateWitness();
    };

    pdPoints.forEach((point) => {
      point.setAttribute('aria-pressed', 'false');

      point.addEventListener('click', () => selectFeature(point.dataset.feature));

      point.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectFeature(point.dataset.feature);
        }
      });
    });

    featureButtons.forEach((button) => {
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => selectFeature(button.dataset.feature));
    });

    jumpButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (!selectedFeature) return;

        let target = selectedFeature.birth;

        if (button.dataset.jump === 'middle') {
          target = Math.floor((selectedFeature.birth + selectedFeature.death) / 2);
        }

        if (button.dataset.jump === 'death') {
          target = selectedFeature.death;
        }

        slider.value = String(target);
        render();
      });
    });

    slider.addEventListener('input', render);
    render();
  }
</script>

<style>
  .filtration-demo {
    margin-top: 2.5rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 28px;
    background: rgba(255, 255, 255, .42);
    box-shadow: var(--shadow);
  }

  .demo-heading {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }

  .demo-heading h2 {
    margin: 0;
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -.035em;
  }

  .demo-heading > p,
  .diagram-help {
    margin: 0;
    color: var(--ink-soft);
  }

  .demo-guide {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .demo-guide li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: .65rem;
    align-items: start;
    padding: .8rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--ink-soft);
    font-size: .85rem;
  }

  .demo-guide span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--paper-deep);
    color: var(--terracotta);
    font-family: ui-serif, Georgia, serif;
  }

  .linked-demo {
    display: grid;
    grid-template-columns: minmax(280px, .9fr) minmax(300px, 1.1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
  }

  .grid-panel h3,
  .diagram-panel h3 {
    margin: 0 0 .75rem;
    font-family: ui-serif, Georgia, serif;
    font-size: 1.3rem;
  }

  .cubical-grid,
  .persistence-diagram {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #e9e3d9;
  }

  [data-cell] {
    fill: rgba(255,255,255,.38);
    stroke: rgba(23,42,58,.07);
    stroke-width: 1;
    transition: fill 160ms ease, stroke 160ms ease, stroke-width 160ms ease;
  }

  [data-cell].is-active { fill: var(--pine); }
  [data-cell].is-hole { fill: var(--ochre); }

  [data-cell].is-witness {
    stroke: var(--terracotta);
    stroke-width: 3;
  }

  .legend,
  .diagram-key {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem 1rem;
    margin-top: .75rem;
    color: var(--ink-soft);
    font-size: .75rem;
  }

  .legend span,
  .diagram-key span {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
  }

  .legend-cell {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.38);
  }

  .legend-cell.active { background: var(--pine); }
  .legend-cell.hole { background: var(--ochre); }

  .legend-cell.witness {
    background: transparent;
