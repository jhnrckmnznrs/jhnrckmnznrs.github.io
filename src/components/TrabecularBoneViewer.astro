---
---

<section class="bone-viewer" data-bone-viewer>
  <div class="source-deck">
    <div>
      <p class="eyebrow">Open a volume</p>
      <div class="source-buttons">
        <label class="file-button">
          <span>Open TIFF or OME TIFF</span>
          <input type="file" accept=".tif,.tiff,image/tiff" data-image-input />
        </label>

        <label class="file-button secondary-source">
          <span>Open slice folder</span>
          <input type="file" multiple webkitdirectory data-series-input />
        </label>

        <label class="file-button quiet-source">
          <span>Open prepared dataset</span>
          <input type="file" multiple webkitdirectory data-prepared-input />
        </label>
      </div>
    </div>

    <p class="source-note">
      Local files stay on this device. The viewer reads them in the browser and does not upload them.
      TIFF and PNG slice folders are supported; mixed folders are rejected rather than guessed.
    </p>
  </div>

  <div class="source-inspector" data-source-inspector hidden>
    <div class="source-summary">
      <div>
        <p class="eyebrow">Detected source</p>
        <h2 data-source-name>Volume</h2>
      </div>
      <span class="strategy-badge" data-strategy>Inspecting</span>
    </div>

    <dl class="source-facts">
      <div><dt>Format</dt><dd data-source-kind>—</dd></div>
      <div><dt>Grid</dt><dd data-source-grid>—</dd></div>
      <div><dt>Files</dt><dd data-source-files>—</dd></div>
      <div><dt>Source size</dt><dd data-source-size>—</dd></div>
      <div><dt>Raw estimate</dt><dd data-raw-size>—</dd></div>
      <div><dt>Workspace estimate</dt><dd data-workspace-size>—</dd></div>
    </dl>

    <div class="planner-note">
      <strong data-planner-title>Processing plan</strong>
      <p data-planner-text></p>
    </div>

    <div class="source-settings">
      <fieldset>
        <legend>Voxel spacing in micrometres</legend>
        <div class="spacing-inputs">
          <label>Z <input type="number" min="0.000001" step="any" value="1" data-spacing-z /></label>
          <label>Y <input type="number" min="0.000001" step="any" value="1" data-spacing-y /></label>
          <label>X <input type="number" min="0.000001" step="any" value="1" data-spacing-x /></label>
        </div>
        <small data-spacing-source>No physical spacing was found. Enter it for a physically correct aspect ratio.</small>
      </fieldset>

      <label class="threshold-field">
        <span>Foreground threshold</span>
        <input type="number" step="any" value="0" data-threshold />
        <small>Voxels with values greater than this threshold are treated as bone.</small>
      </label>

      <button type="button" class="build-button" data-build-overview>Build overview</button>
    </div>

    <details class="ordering-check" data-ordering hidden>
      <summary>Check slice ordering</summary>
      <dl>
        <div><dt>First</dt><dd data-order-first>—</dd></div>
        <div><dt>Middle</dt><dd data-order-middle>—</dd></div>
        <div><dt>Last</dt><dd data-order-last>—</dd></div>
      </dl>
    </details>

    <p class="source-warning" data-source-warning hidden></p>
  </div>

  <div class="viewer-toolbar">
    <div class="viewer-mode">
      <span data-mode-label>No volume open</span>
      <small data-mode-detail>Select a source above.</small>
    </div>

    <div class="viewer-actions">
      <button type="button" data-reset disabled>Reset view</button>
      <button type="button" data-fullscreen>Full screen</button>
      <button type="button" data-screenshot disabled>Save image</button>
    </div>
  </div>

  <div class="viewer-layout">
    <div class="viewer-stage" data-stage>
      <canvas data-canvas aria-label="Three dimensional trabecular bone viewer"></canvas>

      <div class="viewer-empty" data-empty>
        <p class="eyebrow">Viewer ready</p>
        <h2>Open a volume or prepared surface.</h2>
        <p>
          The source is inspected before heavy processing begins. Large inputs are reduced to a streamed
          navigation preview instead of being materialised as one complete browser array.
        </p>
      </div>

      <div class="viewer-loading" data-loading hidden aria-live="polite">
        <span class="loading-dot"></span>
        <span data-loading-text>Loading surface</span>
      </div>

      <div class="viewer-badge" data-level-badge hidden>
        <span data-level-name>Overview</span>
        <small data-level-kind>navigation approximation</small>
      </div>
    </div>

    <aside class="viewer-panel" aria-label="Viewer controls">
      <section>
        <p class="eyebrow">Dataset</p>
        <h3 data-dataset-name>No specimen selected</h3>
        <dl class="dataset-meta">
          <div><dt>Grid</dt><dd data-grid>—</dd></div>
          <div><dt>Spacing</dt><dd data-spacing>—</dd></div>
          <div><dt>Extent</dt><dd data-extent>—</dd></div>
        </dl>
      </section>

      <section>
        <div class="control-heading">
          <div>
            <p class="eyebrow">Surface detail</p>
            <h3>Levels</h3>
          </div>
          <label class="switch-row">
            <input type="checkbox" data-auto-refine checked />
            <span>Progressively refine</span>
          </label>
        </div>

        <div class="level-list" data-level-list>
          <p class="panel-placeholder">Levels appear after the source is inspected.</p>
        </div>

        <p class="level-warning" data-level-warning>
          Generated preview levels are for navigation. Sampling and resampling can alter thin trabeculae and topology.
        </p>
      </section>

      <section>
        <p class="eyebrow">Inspection</p>
        <div class="control-stack">
          <label class="switch-row">
            <input type="checkbox" data-clip-toggle disabled />
            <span>Clipping plane</span>
          </label>
          <label class="range-row">
            <span>Clip position</span>
            <input type="range" min="-1" max="1" step="0.002" value="1" data-clip-range disabled />
          </label>
          <label class="switch-row">
            <input type="checkbox" data-wireframe disabled />
            <span>Wireframe</span>
          </label>
          <label class="switch-row">
            <input type="checkbox" data-axes disabled />
            <span>Coordinate axes</span>
          </label>
          <label class="switch-row">
            <input type="checkbox" data-autorotate />
            <span>Slow rotation</span>
          </label>
        </div>
      </section>

      <section>
        <p class="eyebrow">Performance</p>
        <dl class="metric-grid">
          <div><dt>Triangles</dt><dd data-triangles>—</dd></div>
          <div><dt>Source read</dt><dd data-read-ms>—</dd></div>
          <div><dt>Surface build</dt><dd data-build-ms>—</dd></div>
          <div><dt>First frame</dt><dd data-frame-ms>—</dd></div>
          <div><dt>FPS</dt><dd data-fps>—</dd></div>
          <div><dt>Geometry</dt><dd data-geometry>—</dd></div>
          <div><dt>Level grid</dt><dd data-level-grid>—</dd></div>
          <div><dt>Transferred</dt><dd data-transferred>—</dd></div>
        </dl>
      </section>

      <section class="viewer-status">
        <p class="eyebrow">Status</p>
        <p data-status aria-live="polite">Waiting for a volume.</p>
      </section>
    </aside>
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import {
    openSingleTiff,
    openSliceSeries,
    buildBinaryVolume,
    planVolume
  } from '../lib/boneViewer/volumeSources.js';

  const root = document.querySelector('[data-bone-viewer]');

  if (root) {
    const canvas = root.querySelector('[data-canvas]');
    const stage = root.querySelector('[data-stage]');
    const imageInput = root.querySelector('[data-image-input]');
    const seriesInput = root.querySelector('[data-series-input]');
    const preparedInput = root.querySelector('[data-prepared-input]');

    const sourceInspector = root.querySelector('[data-source-inspector]');
    const sourceName = root.querySelector('[data-source-name]');
    const sourceKind = root.querySelector('[data-source-kind]');
    const sourceGrid = root.querySelector('[data-source-grid]');
    const sourceFiles = root.querySelector('[data-source-files]');
    const sourceSize = root.querySelector('[data-source-size]');
    const rawSize = root.querySelector('[data-raw-size]');
    const workspaceSize = root.querySelector('[data-workspace-size]');
    const strategyNode = root.querySelector('[data-strategy]');
    const plannerTitle = root.querySelector('[data-planner-title]');
    const plannerText = root.querySelector('[data-planner-text]');
    const sourceWarning = root.querySelector('[data-source-warning]');

    const spacingZ = root.querySelector('[data-spacing-z]');
    const spacingY = root.querySelector('[data-spacing-y]');
    const spacingX = root.querySelector('[data-spacing-x]');
    const spacingSource = root.querySelector('[data-spacing-source]');
    const thresholdInput = root.querySelector('[data-threshold]');
    const buildOverviewButton = root.querySelector('[data-build-overview]');

    const ordering = root.querySelector('[data-ordering]');
    const orderFirst = root.querySelector('[data-order-first]');
    const orderMiddle = root.querySelector('[data-order-middle]');
    const orderLast = root.querySelector('[data-order-last]');

    const modeLabel = root.querySelector('[data-mode-label]');
    const modeDetail = root.querySelector('[data-mode-detail]');
    const emptyState = root.querySelector('[data-empty]');
    const loading = root.querySelector('[data-loading]');
    const loadingText = root.querySelector('[data-loading-text]');
    const statusNode = root.querySelector('[data-status]');
    const levelList = root.querySelector('[data-level-list]');
    const levelBadge = root.querySelector('[data-level-badge]');
    const levelName = root.querySelector('[data-level-name]');
    const levelKind = root.querySelector('[data-level-kind]');

    const datasetName = root.querySelector('[data-dataset-name]');
    const gridNode = root.querySelector('[data-grid]');
    const spacingNode = root.querySelector('[data-spacing]');
    const extentNode = root.querySelector('[data-extent]');

    const autoRefine = root.querySelector('[data-auto-refine]');
    const clipToggle = root.querySelector('[data-clip-toggle]');
    const clipRange = root.querySelector('[data-clip-range]');
    const wireframeToggle = root.querySelector('[data-wireframe]');
    const axesToggle = root.querySelector('[data-axes]');
    const autorotateToggle = root.querySelector('[data-autorotate]');
    const resetButton = root.querySelector('[data-reset]');
    const fullscreenButton = root.querySelector('[data-fullscreen]');
    const screenshotButton = root.querySelector('[data-screenshot]');

    const triangleNode = root.querySelector('[data-triangles]');
    const readNode = root.querySelector('[data-read-ms]');
    const buildNode = root.querySelector('[data-build-ms]');
    const frameNode = root.querySelector('[data-frame-ms]');
    const fpsNode = root.querySelector('[data-fps]');
    const geometryNode = root.querySelector('[data-geometry]');
    const levelGridNode = root.querySelector('[data-level-grid]');
    const transferredNode = root.querySelector('[data-transferred]');

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      preserveDrawingBuffer: true,
      powerPreference: 'high-performance'
    });

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.localClippingEnabled = true;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.001, 1000);
    camera.position.set(11, 8, 11);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.07;
    controls.screenSpacePanning = true;

    scene.add(new THREE.HemisphereLight(0xf8f3e8, 0x263742, 2.0));

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.7);
    keyLight.position.set(6, 9, 8);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xc9d9d0, 1.1);
    fillLight.position.set(-7, 2, -4);
    scene.add(fillLight);

    const clipPlane = new THREE.Plane(new THREE.Vector3(0, 0, -1), 1000);

    const material = new THREE.MeshStandardMaterial({
      color: 0xd8cbb7,
      roughness: 0.72,
      metalness: 0.0,
      side: THREE.DoubleSide,
      clippingPlanes: []
    });

    const axes = new THREE.AxesHelper(2);
    axes.visible = false;
    scene.add(axes);

    const gltfLoader = new GLTFLoader();

    let currentObject = null;
    let currentLevelId = null;
    let modelBounds = null;
    let loadingLevelId = null;
    let currentMode = null;

    let currentSource = null;
    let currentPlan = null;

    let currentManifest = null;
    let preparedFileMap = new Map();
    let manifestRoot = '';

    let refineToken = 0;

    const formatBytes = (bytes) => {
      if (!Number.isFinite(bytes)) return '—';
      if (bytes < 1024) return `${Math.round(bytes)} B`;
      if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
      if (bytes < 1024 ** 3) return `${(bytes / 1024 ** 2).toFixed(bytes < 10 * 1024 ** 2 ? 2 : 1)} MB`;
      return `${(bytes / 1024 ** 3).toFixed(2)} GB`;
    };

    const formatMs = (ms) => Number.isFinite(ms)
      ? `${ms.toFixed(ms < 10 ? 1 : 0)} ms`
      : '—';

    const setStatus = (text) => {
      statusNode.textContent = text;
    };

    const setLoading = (active, text = 'Loading surface') => {
      loading.hidden = !active;
      loadingText.textContent = text;
    };

    const setControlsEnabled = (enabled) => {
      clipToggle.disabled = !enabled;
      wireframeToggle.disabled = !enabled;
      axesToggle.disabled = !enabled;
      resetButton.disabled = !enabled;
      screenshotButton.disabled = !enabled;
      clipRange.disabled = !enabled || !clipToggle.checked;
    };

    const resetMetrics = () => {
      triangleNode.textContent = '—';
      readNode.textContent = '—';
      buildNode.textContent = '—';
      frameNode.textContent = '—';
      geometryNode.textContent = '—';
      levelGridNode.textContent = '—';
      transferredNode.textContent = '—';
    };

    const disposeObject = (object) => {
      if (!object) return;
      object.traverse((child) => {
        if (child.isMesh) child.geometry?.dispose();
      });
      scene.remove(object);
    };

    const clearSurface = () => {
      disposeObject(currentObject);
      currentObject = null;
      currentLevelId = null;
      modelBounds = null;
      levelBadge.hidden = true;
      emptyState.hidden = false;
      setControlsEnabled(false);
      resetMetrics();
    };

    const applyMaterial = (object) => {
      object.traverse((child) => {
        if (!child.isMesh) return;
        child.material = material;
        child.castShadow = false;
        child.receiveShadow = false;
      });
    };

    const fitCamera = (object, preserveView = false) => {
      const box = new THREE.Box3().setFromObject(object);
      modelBounds = box.clone();

      if (preserveView) return;

      const sphere = box.getBoundingSphere(new THREE.Sphere());
      const radius = Math.max(sphere.radius, 0.001);
      const distance = radius / Math.tan(THREE.MathUtils.degToRad(camera.fov * 0.5));

      camera.near = Math.max(radius / 500, 0.001);
      camera.far = Math.max(radius * 100, 100);
      camera.updateProjectionMatrix();

      camera.position.copy(sphere.center).add(
        new THREE.Vector3(1, 0.72, 1).normalize().multiplyScalar(distance * 1.25)
      );
      controls.target.copy(sphere.center);
      controls.update();

      axes.position.copy(box.min);
      axes.scale.setScalar(Math.max(radius * 0.3, 0.5));
    };

    const replaceSurface = (object, preserveView = false) => {
      const previous = currentObject;
      currentObject = object;
      scene.add(object);
      fitCamera(object, preserveView);
      updateClipping();
      if (previous) disposeObject(previous);
      emptyState.hidden = true;
      setControlsEnabled(true);
    };

    const updateClipping = () => {
      if (!modelBounds || !clipToggle.checked) {
        material.clippingPlanes = [];
        material.needsUpdate = true;
        return;
      }

      const t = (Number(clipRange.value) + 1) / 2;
      const z = THREE.MathUtils.lerp(modelBounds.min.z, modelBounds.max.z, t);
      clipPlane.set(new THREE.Vector3(0, 0, -1), z);
      material.clippingPlanes = [clipPlane];
      material.needsUpdate = true;
    };

    const physicalSpacingMicrometres = () => {
      const values = [spacingZ, spacingY, spacingX].map((input) => Number(input.value));
      if (!values.every((value) => Number.isFinite(value) && value > 0)) {
        throw new Error('Voxel spacing values must be positive numbers.');
      }
      return values;
    };

    const updateDatasetPhysicalMetadata = (shapeZYX, spacingMicrometresZYX) => {
      const extentMm = shapeZYX.map((value, index) => value * spacingMicrometresZYX[index] / 1000);
      spacingNode.textContent = `${spacingMicrometresZYX.map((value) => Number(value).toFixed(3)).join(' × ')} µm`;
      extentNode.textContent = `${extentMm.map((value) => value.toFixed(2)).join(' × ')} mm`;
    };

    const showSourceInspection = (source, plan) => {
      sourceInspector.hidden = false;

      const metadata = source.metadata;
      sourceName.textContent = metadata.name;
      sourceKind.textContent = metadata.kind;
      sourceGrid.textContent = metadata.shapeZYX.join(' × ');
      sourceFiles.textContent = Number(metadata.fileCount).toLocaleString();
      sourceSize.textContent = formatBytes(metadata.sourceBytes);
      rawSize.textContent = formatBytes(plan.rawBytes);
      workspaceSize.textContent = formatBytes(plan.workspaceBytes);

      strategyNode.textContent = plan.strategyLabel;
      strategyNode.dataset.strategy = plan.strategy;
      plannerTitle.textContent = plan.strategyLabel;
      plannerText.textContent = plan.explanation;

      datasetName.textContent = metadata.name;
      gridNode.textContent = metadata.shapeZYX.join(' × ');

      const spacing = metadata.spacingMicrometresZYX || [1, 1, 1];
      [spacingZ.value, spacingY.value, spacingX.value] = spacing.map(String);
      spacingSource.textContent = metadata.spacingSource
        ? `Spacing loaded from ${metadata.spacingSource}.`
        : 'No physical spacing was found. Enter Z, Y, and X spacing before quantitative inspection.';

      updateDatasetPhysicalMetadata(metadata.shapeZYX, spacing);

      if (metadata.ordering) {
        ordering.hidden = false;
        orderFirst.textContent = metadata.ordering.first;
        orderMiddle.textContent = metadata.ordering.middle;
        orderLast.textContent = metadata.ordering.last;
      } else {
        ordering.hidden = true;
      }

      sourceWarning.hidden = !metadata.warning;
      sourceWarning.textContent = metadata.warning || '';

      modeLabel.textContent = plan.strategyLabel;
      modeDetail.textContent = metadata.kind;

      renderGeneratedLevels();
      setStatus('Source inspected. Check spacing and threshold, then build the overview.');
    };

    const beginSource = async (promise) => {
      refineToken += 1;
      clearSurface();
      currentManifest = null;
      preparedFileMap = new Map();
      currentMode = 'source';
      currentSource = null;
      currentPlan = null;
      sourceInspector.hidden = true;
      levelList.innerHTML = '<p class="panel-placeholder">Inspecting the selected source…</p>';
      setLoading(true, 'Inspecting volume metadata');
      setStatus('Inspecting the selected source before heavy processing begins…');

      try {
        const source = await promise;
        const plan = planVolume(source.metadata);
        currentSource = source;
        currentPlan = plan;
        showSourceInspection(source, plan);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : 'The selected volume could not be inspected.');
        levelList.innerHTML = '<p class="panel-placeholder">No usable volume was detected.</p>';
      } finally {
        setLoading(false);
      }
    };

    const makeGeneratedObject = ({ positions, indices }) => {
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));
      geometry.setIndex(new THREE.BufferAttribute(new Uint32Array(indices), 1));
      geometry.computeVertexNormals();
      geometry.computeBoundingBox();
      geometry.computeBoundingSphere();

      const mesh = new THREE.Mesh(geometry, material);
      const group = new THREE.Group();
      group.add(mesh);
      return group;
    };

    const runSurfaceWorker = (volume, shapeZYX, spacingZYX) => new Promise((resolve, reject) => {
      const worker = new Worker(
        new URL('../workers/boneSurfaceWorker.js', import.meta.url),
        { type: 'module' }
      );

      worker.onmessage = (event) => {
        worker.terminate();
        resolve(event.data);
      };

      worker.onerror = (event) => {
        worker.terminate();
        reject(new Error(event.message || 'The surface worker failed.'));
      };

      worker.postMessage(
        {
          buffer: volume.buffer,
          shapeZYX,
          spacingZYX
        },
        [volume.buffer]
      );
    });

    const targetSpacingMm = (sourceShape, targetShape, spacingMicrometres) =>
      sourceShape.map((sourceValue, index) => {
        const targetValue = targetShape[index];
        const sourceIntervals = Math.max(1, sourceValue - 1);
        const targetIntervals = Math.max(1, targetValue - 1);
        return spacingMicrometres[index] / 1000 * sourceIntervals / targetIntervals;
      });

    const updateGeneratedButtons = () => {
      const buttons = levelList.querySelectorAll('button[data-level]');
      buttons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.level === currentLevelId);
        button.disabled = loadingLevelId !== null;
      });
    };

    const renderGeneratedLevels = () => {
      if (!currentPlan) return;
      levelList.innerHTML = '';

      for (const level of currentPlan.levels) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.level = level.id;
        button.innerHTML = `
          <span>
            <strong>${level.label}</strong>
            <small>${level.id === 'detail' ? 'native source grid' : 'generated navigation surface'}</small>
          </span>
          <span class="level-size">
            ${level.shapeZYX.join(' × ')}
            <small>target grid</small>
          </span>
        `;

        button.addEventListener('click', () => {
          refineToken += 1;
          generateLevel(level.id, false);
        });

        levelList.appendChild(button);
      }
    };

    const scheduleGeneratedRefinement = async (loadedId, token) => {
      if (!autoRefine.checked || token !== refineToken || !currentPlan || !currentSource) return;

      const index = currentPlan.levels.findIndex((level) => level.id === loadedId);
      const next = currentPlan.levels[index + 1];
      if (!next || next.id === 'detail') return;

      if (currentPlan.strategy === 'spatial') return;
      if (currentPlan.strategy === 'streaming' && loadedId === 'preview') return;

      await new Promise((resolve) => setTimeout(resolve, 400));

      if (
        token === refineToken &&
        autoRefine.checked &&
        currentLevelId === loadedId &&
        !loadingLevelId
      ) {
        generateLevel(next.id, true);
      }
    };

    const generateLevel = async (levelId, automatic = false) => {
      if (!currentSource || !currentPlan || loadingLevelId) return;

      const level = currentPlan.levels.find((item) => item.id === levelId);
      if (!level) return;

      const token = refineToken;
      const spacingMicrometres = physicalSpacingMicrometres();
      const threshold = Number(thresholdInput.value);

      if (!Number.isFinite(threshold)) {
        setStatus('The foreground threshold must be a number.');
        return;
      }

      loadingLevelId = level.id;
      updateGeneratedButtons();
      setLoading(true, automatic ? `Refining to ${level.label}` : `Building ${level.label}`);
      setStatus(
        `${automatic ? 'Refining' : 'Building'} ${level.label}. Reading only the slices needed for a ${level.shapeZYX.join(' × ')} working volume…`
      );

      const start = performance.now();
      const readStart = performance.now();

      try {
        const volume = await buildBinaryVolume(
          currentSource,
          level.shapeZYX,
          threshold,
          (fraction, sourceIndex) => {
            const percent = Math.round(fraction * 100);
            loadingText.textContent = `${level.label}: reading source slice ${sourceIndex + 1} · ${percent}%`;
          }
        );

        const readMs = performance.now() - readStart;
        const targetSpacing = targetSpacingMm(
          currentSource.metadata.shapeZYX,
          level.shapeZYX,
          spacingMicrometres
        );

        loadingText.textContent = `${level.label}: extracting surface`;
        const surface = await runSurfaceWorker(volume, level.shapeZYX, targetSpacing);

        const object = makeGeneratedObject(surface);
        const preserveView = currentObject !== null;
        replaceSurface(object, preserveView);
        currentLevelId = level.id;

        const firstFrameMs = await new Promise((resolve) => {
          requestAnimationFrame(() => {
            renderer.render(scene, camera);
            resolve(performance.now() - start);
          });
        });

        const geometryBytes =
          surface.vertices * 3 * Float32Array.BYTES_PER_ELEMENT +
          surface.triangles * 3 * Uint32Array.BYTES_PER_ELEMENT;

        triangleNode.textContent = Number(surface.triangles).toLocaleString();
        readNode.textContent = formatMs(readMs);
        buildNode.textContent = formatMs(surface.buildMs);
        frameNode.textContent = formatMs(firstFrameMs);
        geometryNode.textContent = formatBytes(geometryBytes);
        levelGridNode.textContent = level.shapeZYX.join(' × ');
        transferredNode.textContent = formatBytes(level.shapeZYX.reduce((a, b) => a * b, 1));

        levelName.textContent = level.label;
        levelKind.textContent = level.id === 'detail'
          ? 'surface from native source grid'
          : 'generated navigation approximation';
        levelBadge.hidden = false;

        const spacing = physicalSpacingMicrometres();
        updateDatasetPhysicalMetadata(currentSource.metadata.shapeZYX, spacing);

        setStatus(
          level.id === 'detail'
            ? `${level.label} is visible. This surface uses the native source grid at the chosen threshold.`
            : `${level.label} is visible. It is a resampled navigation surface and can miss or alter thin structures.`
        );

        updateGeneratedButtons();
        scheduleGeneratedRefinement(level.id, token);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : 'The surface could not be generated.');
      } finally {
        loadingLevelId = null;
        setLoading(false);
        updateGeneratedButtons();
      }
    };

    buildOverviewButton.addEventListener('click', () => {
      refineToken += 1;
      const firstLevel = currentPlan?.levels?.[0];
      if (firstLevel) generateLevel(firstLevel.id, false);
    });

    imageInput.addEventListener('change', () => {
      const file = imageInput.files?.[0];
      if (file) beginSource(openSingleTiff(file));
    });

    seriesInput.addEventListener('change', () => {
      const files = Array.from(seriesInput.files || []);
      if (files.length) beginSource(openSliceSeries(files));
    });

    const fileRelativeToManifest = (file) => {
      const path = file.webkitRelativePath || file.name;
      if (!manifestRoot) return path;
      return path.startsWith(manifestRoot) ? path.slice(manifestRoot.length) : path;
    };

    const readCompressedFile = async (file) => {
      const readStart = performance.now();
      const compressed = await file.arrayBuffer();
      const readMs = performance.now() - readStart;

      if (!file.name.endsWith('.gz')) {
        return { buffer: compressed, readMs, decompressMs: 0 };
      }

      if (!('DecompressionStream' in window)) {
        throw new Error('This browser does not support gzip decompression streams.');
      }

      const decompressStart = performance.now();
      const stream = new Blob([compressed])
        .stream()
        .pipeThrough(new DecompressionStream('gzip'));
      const buffer = await new Response(stream).arrayBuffer();
      const decompressMs = performance.now() - decompressStart;

      return { buffer, readMs, decompressMs };
    };

    const updatePreparedButtons = () => {
      if (!currentManifest) return;
      const buttons = levelList.querySelectorAll('button[data-level]');
      buttons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.level === currentLevelId);
        button.disabled = loadingLevelId !== null;
      });
    };

    const renderPreparedLevels = () => {
      levelList.innerHTML = '';

      for (const level of currentManifest.levels) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.level = level.id;
        button.innerHTML = `
          <span>
            <strong>${level.label}</strong>
            <small>${level.approximation === 'native segmentation' ? 'native surface' : 'prepared navigation surface'}</small>
          </span>
          <span class="level-size">
            ${formatBytes(level.compressedBytes)}
            <small>${Number(level.triangles).toLocaleString()} triangles</small>
          </span>
        `;

        button.addEventListener('click', () => {
          refineToken += 1;
          loadPreparedLevel(level.id, false);
        });

        levelList.appendChild(button);
      }
    };

    const schedulePreparedRefinement = async (loadedId, token) => {
      if (!autoRefine.checked || token !== refineToken || !currentManifest) return;

      const progression = currentManifest.progression || currentManifest.levels.map((level) => level.id);
      const index = progression.indexOf(loadedId);
      const nextId = progression[index + 1];

      if (!nextId || nextId === 'detail') return;

      await new Promise((resolve) => setTimeout(resolve, 350));

      if (token === refineToken && autoRefine.checked && currentLevelId === loadedId && !loadingLevelId) {
        loadPreparedLevel(nextId, true);
      }
    };

    const loadPreparedLevel = async (levelId, automatic = false) => {
      if (!currentManifest || loadingLevelId) return;

      const level = currentManifest.levels.find((item) => item.id === levelId);
      if (!level) return;

      const file = preparedFileMap.get(level.file);
      if (!file) {
        setStatus(`The folder does not contain ${level.file}.`);
        return;
      }

      const token = refineToken;
      loadingLevelId = levelId;
      updatePreparedButtons();
      setLoading(true, automatic ? `Refining to ${level.label}` : `Loading ${level.label}`);
      setStatus(`${automatic ? 'Refining' : 'Loading'} ${level.label} from this device…`);

      try {
        const start = performance.now();
        const { buffer, readMs, decompressMs } = await readCompressedFile(file);

        const parseStart = performance.now();
        const gltf = await gltfLoader.parseAsync(buffer, '');
        const parseMs = performance.now() - parseStart;

        const object = gltf.scene;
        applyMaterial(object);
        replaceSurface(object, currentObject !== null);
        currentLevelId = level.id;

        const firstFrameMs = await new Promise((resolve) => {
          requestAnimationFrame(() => {
            renderer.render(scene, camera);
            resolve(performance.now() - start);
          });
        });

        const estimatedGeometryBytes =
          Number(level.vertices || 0) * 24 +
          Number(level.triangles || 0) * 12;

        triangleNode.textContent = Number(level.triangles).toLocaleString();
        readNode.textContent = formatMs(readMs + decompressMs);
        buildNode.textContent = formatMs(parseMs);
        frameNode.textContent = formatMs(firstFrameMs);
        geometryNode.textContent = formatBytes(estimatedGeometryBytes);
        levelGridNode.textContent = (level.sourceGrid || []).join(' × ') || '—';
        transferredNode.textContent = formatBytes(file.size);

        levelName.textContent = level.label;
        levelKind.textContent = level.approximation === 'native segmentation'
          ? 'surface from native segmentation'
          : 'prepared navigation approximation';
        levelBadge.hidden = false;

        setStatus(
          level.approximation === 'native segmentation'
            ? `${level.label} is visible. This surface was extracted from the native segmentation.`
            : `${level.label} is visible. This prepared level is a navigation approximation.`
        );

        updatePreparedButtons();
        schedulePreparedRefinement(level.id, token);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : 'The prepared surface could not be loaded.');
      } finally {
        loadingLevelId = null;
        setLoading(false);
        updatePreparedButtons();
      }
    };

    const loadPreparedFolder = async (files) => {
      refineToken += 1;
      clearSurface();
      currentMode = 'prepared';
      currentSource = null;
      currentPlan = null;
      sourceInspector.hidden = true;

      const manifestFile = files.find((file) => file.name === 'manifest.json');
      if (!manifestFile) {
        setStatus('No manifest.json was found in the selected prepared dataset folder.');
        return;
      }

      const manifestPath = manifestFile.webkitRelativePath || manifestFile.name;
      manifestRoot = manifestPath.slice(0, manifestPath.length - 'manifest.json'.length);

      try {
        const manifest = JSON.parse(await manifestFile.text());

        if (manifest.format !== 'banyuhay-bone-viewer' || manifest.version !== 1) {
          throw new Error('This folder does not use the supported Banyuhay prepared dataset format.');
        }

        currentManifest = manifest;
        preparedFileMap = new Map(files.map((file) => [fileRelativeToManifest(file), file]));

        datasetName.textContent = manifest.label || manifest.id || 'Prepared specimen';
        gridNode.textContent = (manifest.source?.shapeZYX || []).join(' × ') || '—';

        const spacing = manifest.source?.spacingMicrometresZYX || [];
        if (spacing.length === 3) {
          updateDatasetPhysicalMetadata(manifest.source.shapeZYX, spacing);
        } else {
          spacingNode.textContent = '—';
          extentNode.textContent = '—';
        }

        modeLabel.textContent = 'Prepared multiresolution dataset';
        modeDetail.textContent = 'Fast repeat viewing';
        renderPreparedLevels();

        const defaultLevel = manifest.defaultLevel || manifest.levels?.[0]?.id;
        if (!defaultLevel) throw new Error('The manifest contains no surface levels.');

        setStatus('Prepared dataset loaded. Opening the smallest surface first.');
        await loadPreparedLevel(defaultLevel, false);
      } catch (error) {
        console.error(error);
        setStatus(error instanceof Error ? error.message : 'The prepared dataset could not be read.');
      }
    };

    preparedInput.addEventListener('change', () => {
      const files = Array.from(preparedInput.files || []);
      if (files.length) loadPreparedFolder(files);
    });

    clipToggle.addEventListener('change', () => {
      clipRange.disabled = !clipToggle.checked;
      updateClipping();
    });

    clipRange.addEventListener('input', updateClipping);

    wireframeToggle.addEventListener('change', () => {
      material.wireframe = wireframeToggle.checked;
      material.needsUpdate = true;
    });

    axesToggle.addEventListener('change', () => {
      axes.visible = axesToggle.checked;
    });

    resetButton.addEventListener('click', () => {
      if (currentObject) fitCamera(currentObject, false);
    });

    fullscreenButton.addEventListener('click', async () => {
      try {
        if (!document.fullscreenElement) {
          await stage.requestFullscreen();
        } else {
          await document.exitFullscreen();
        }
      } catch {
        setStatus('Full screen mode is not available in this browser context.');
      }
    });

    screenshotButton.addEventListener('click', () => {
      renderer.render(scene, camera);
      canvas.toBlob((blob) => {
        if (!blob) return;
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        const id = currentManifest?.id || currentSource?.metadata?.name || 'bone';
        link.download = `${String(id).replace(/[^a-z0-9]+/gi, '_')}-${currentLevelId || 'surface'}.png`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
      }, 'image/png');
    });

    let fpsFrames = 0;
    let fpsStart = performance.now();

    const resize = () => {
      const width = Math.max(stage.clientWidth, 1);
      const height = Math.max(stage.clientHeight, 1);
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(stage);
    resize();

    const animate = (now) => {
      controls.autoRotate = autorotateToggle.checked;
      controls.autoRotateSpeed = 0.8;
      controls.update();

      renderer.render(scene, camera);

      fpsFrames += 1;
      const elapsed = now - fpsStart;

      if (elapsed >= 1000) {
        fpsNode.textContent = String(Math.round((fpsFrames * 1000) / elapsed));
        fpsFrames = 0;
        fpsStart = now;
      }

      requestAnimationFrame(animate);
    };

    requestAnimationFrame(animate);
  }
</script>

